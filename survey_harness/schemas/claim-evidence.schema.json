{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Survey claim-evidence entry",
  "type": "object",
  "required": ["claim_id", "chapter", "claim", "risk", "source_ids", "verification_status"],
  "properties": {
    "claim_id": {"type": "string"},
    "chapter": {"type": "integer", "minimum": 1},
    "claim": {"type": "string", "minLength": 8},
    "risk": {"enum": ["high", "medium", "low"]},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification_status": {"enum": ["verified", "qualified", "unverified", "rejected"]},
    "caveat": {"type": ["string", "null"]},
    "manuscript_anchors": {
      "type": "object",
      "required": ["ko", "en"],
      "additionalProperties": false,
      "properties": {
        "ko": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "en": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
